# MongoDB Configuration
# Remplacez <username>, <password>, <cluster>, et <database> par vos valeurs
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Word Template URLs
# URL du modèle Word pour les plans hebdomadaires
WORD_TEMPLATE_URL=https://votre-url-template.com/template.docx

# URL du modèle Word pour les plans de leçon
LESSON_TEMPLATE_URL=https://votre-url-template.com/lesson-template.docx

# Gemini AI API Key (pour la génération de plans de leçons IA)
GEMINI_API_KEY=votre_cle_api_gemini

# Port du serveur (optionnel, 3000 par défaut)
PORT=3000
