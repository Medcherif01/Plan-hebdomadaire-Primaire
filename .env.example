# Configuration MongoDB
MONGO_URL=votre_url_mongodb

# URLs des templates Word
WORD_TEMPLATE_URL=https://votre-url-template-hebdomadaire.docx
LESSON_TEMPLATE_URL=https://votre-url-template-lesson.docx

# Clés API Gemini (4 clés pour rotation automatique)
# ⚠️ CRÉEZ DE NOUVELLES CLÉS sur: https://aistudio.google.com/apikey
# Les anciennes clés sont COMPROMISES et BLOQUÉES par Google
# Format: AIza... (39 caractères)
GEMINI_API_KEY_1=votre_nouvelle_clé_projet_1
GEMINI_API_KEY_2=votre_nouvelle_clé_projet_2
GEMINI_API_KEY_3=votre_nouvelle_clé_projet_3
GEMINI_API_KEY_4=votre_nouvelle_clé_projet_4

# VAPID Keys pour Web Push Notifications
VAPID_PUBLIC_KEY=votre_vapid_public_key
VAPID_PRIVATE_KEY=votre_vapid_private_key

# Clé API pour les tâches cron
CRON_API_KEY=votre_cle_securisee_pour_cron
